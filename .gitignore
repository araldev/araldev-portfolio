# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# npm lock files — this project uses pnpm, see pnpm-lock.yaml.
# Created by accident by some sub-tool that runs npm install.
package-lock.json
npm-shrinkwrap.json

