#!/usr/bin/env sh
# .husky/pre-commit — scope-watch the N4 visual regression gate.
#
# Runs `pnpm test:visual` ONLY when staged files include any path
# under the 4 components that 004-ux-overhaul-and-relayout-root-fix
# scopes visual coverage to:
#
#   - src/components/ProjectsCards/  (N1, P3)
#   - src/components/JobsCards/      (N2, P2)
#   - src/components/JobCard/        (N2, P2)
#   - src/components/AboutMe/        (N3, P2)
#
# Other commits (e.g. a hook change, a CSS variable tweak in index.css,
# a Hook update that does not touch JobCard) skip the visual gate so
# the dev loop stays fast. The contract is:
#   - Touch a scoped component → visual gate runs.
#   - Touch anything else → no visual gate, normal `pnpm test:run` in CI.
#
# Override locally with `git commit --no-verify` if you have a reason
# (document it in the commit body).

CHANGED=$(git diff --cached --name-only)
if echo "$CHANGED" | grep -qE '^src/components/(ProjectsCards|JobsCards|JobCard|AboutMe)/'; then
  echo "🧪 N4 visual regression scope triggered (staged files in ProjectsCards/JobsCards/JobCard/AboutMe)"
  echo "   Running pnpm test:visual..."
  pnpm test:visual || {
    echo ""
    echo "❌ Visual regression FAILED. Options:"
    echo "   1. If the change is intentional, regenerate baselines: pnpm test:visual:update"
    echo "   2. If the change is unintentional, fix the source and re-commit."
    echo "   3. To skip this hook (e.g. emergency hotfix), use: git commit --no-verify"
    exit 1
  }
fi
